# Everything here is optional. Without .env the system runs completely,
# answering extractively instead of with written answers.

# Language model (one is enough)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# Real embeddings instead of the built-in feature hashing
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Signing secret of the login tokens: change it for anything but the demo
# TOKEN_SECRET=

# Show the number of blocked hits. Turn off in very strict environments,
# where even a count hints that something exists.
# SHOW_BLOCKED_COUNT=true

# Database passwords and ports
# DB_OWNER_PASSWORD=kg_owner_pw
# DB_APP_PASSWORD=kg_app_pw
# DB_PORT=5433
# API_PORT=8000
# UI_PORT=8501
