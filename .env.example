# Alles hier ist freiwillig. Ohne .env laeuft das System vollstaendig --
# dann belegbasiert statt mit formulierten Antworten.

# Sprachmodell (eines genuegt)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Echte Einbettungen statt des eingebauten Textvergleichs
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Signaturgeheimnis der Anmeldetoken -- fuer alles ausser der Vorfuehrung aendern
# TOKEN_SECRET=bitte-aendern

# Zahl gesperrter Treffer anzeigen. In sehr strengen Umgebungen abschalten:
# schon eine Zahl ist ein Hinweis darauf, dass es etwas gibt.
# SHOW_BLOCKED_COUNT=true

# Datenbankkennwoerter und Ports
# DB_OWNER_PASSWORD=kg_owner_pw
# DB_APP_PASSWORD=kg_app_pw
# DB_PORT=5433
# API_PORT=8000
# UI_PORT=8501
